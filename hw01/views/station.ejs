<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= station.name %></title>
</head>
<body>

  <h1><%= station.name %></h1>

  <p>Biome: <%= station.biome %></p>
  <p>Elevation: <%= station.elevation %></p>

  <h2>Station Readings</h2>

  <ul>
    <% readings.forEach(reading => { %>
      <li>
        <%= reading.type %>:
        <%= reading.value %> <%= reading.unit %>
      </li>
    <% }) %>
  </ul>

</body>
</html>